      <h2>Cylinders for Every Need</h2>
      <p class="section-sub">From household kitchens to commercial hotels, we stock the sizes Palpa depends on.</p>
    </div>
    <% if (products.length === 0) { %>
      <p class="empty">No products available yet. Please check back soon.</p>
    <% } else { %>
      <div class="product-grid">
        <% products.forEach(function(product) { %>
          <div class="product-card">
            <div class="product-icon">🛢️</div>
            <h3><%= product.name %></h3>
            <p class="description"><%= product.description %></p>
            <p class="price">Rs. <%= product.price.toFixed(2) %></p>
            <p class="stock <%= product.stock > 0 ? 'in-stock' : 'out-of-stock' %>">
              <%= product.stock > 0 ? product.stock + ' in stock' : 'Out of stock' %>
            </p>
            <a href="#" role="button" data-copy="+977-9847374696" class="btn btn-small btn-block">Order This</a>
