<%- include('../partials/header') %>

<div class="admin-page-head">
  <a href="/admin/products" class="admin-back-link"><%- include('../partials/icon', { name: 'back' }) %>Back to products</a>
  <h1><%= product && product.id ? 'Edit Product' : 'New Product' %></h1>
</div>

<% if (error) { %>
  <div class="admin-alert admin-alert-error"><%= error %></div>
<% } %>

<div class="admin-panel admin-panel-narrow">
  <form method="POST" action="<%= product && product.id ? '/admin/products/' + product.id : '/admin/products' %>" class="admin-form">
    <label>
      Product Name
      <input type="text" name="name" value="<%= product ? product.name || '' : '' %>" required />
    </label>
    <label>
      Description
      <textarea name="description" rows="3"><%= product ? product.description || '' : '' %></textarea>
    </label>
    <div class="admin-form-row">
      <label>
        Price (Rs.)
        <input type="number" step="0.01" min="0" name="price" value="<%= product ? product.price || '' : '' %>" required />
      </label>
      <label>
        Stock
        <input type="number" min="0" name="stock" value="<%= product ? (product.stock ?? 0) : 0 %>" />
      </label>
    </div>
    <button type="submit" class="btn"><%= product && product.id ? 'Save Changes' : 'Create Product' %></button>
  </form>
</div>

<%- include('../partials/footer') %>
