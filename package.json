{
  "name": "agrahari-gas",
  "version": "1.0.0",
  "description": "Gas supplier",
  "license": "ISC",
  "author": "aspasht",
  "type": "commonjs",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch --include \"views/**/*\" --include \"public/**/*\" src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "admin:hash": "tsx src/scripts/hash-password.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-session": "^1.18.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.1",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
